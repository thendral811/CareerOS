# ==========================================
# CareerOS - Git Ignore
# ==========================================

# Node.js dependencies
node_modules/
**/node_modules/

# Environment files / secrets
.env
.env.*
!.env.example

# Build output
dist/
**/dist/
build/
**/build/
.vite/

# Python virtual environments
venv/
.venv/
**/venv/
**/.venv/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]

# User uploaded files
uploads/
**/uploads/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp